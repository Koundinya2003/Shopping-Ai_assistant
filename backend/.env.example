# OpenRouter API Key (for LLM-powered recommendation explanations)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL (optional, defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter Model (optional, defaults to deepseek/deepseek-chat-v3)
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3

# OpenRouter request timeout in seconds (optional, defaults to 30.0)
# OPENROUTER_TIMEOUT=30.0

# OpenRouter max retries on failure (optional, defaults to 3)
# OPENROUTER_MAX_RETRIES=3

# OpenRouter initial retry delay in seconds (optional, defaults to 1.0)
# OPENROUTER_INITIAL_RETRY_DELAY=1.0

# OpenRouter max retry delay in seconds (optional, defaults to 10.0)
# OPENROUTER_MAX_RETRY_DELAY=10.0

# OpenRouter backoff multiplier for retry delays (optional, defaults to 2.0)
# OPENROUTER_BACKOFF_MULTIPLIER=2.0

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./grocery_assistant.db

# CORS allowed origins (comma-separated, for production)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
